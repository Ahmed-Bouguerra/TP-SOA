    {
      "name": "GET liste des livres (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Code 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('Format total/page/limit/data', () => { pm.expect(r).to.have.keys(['total','page','limit','data']); pm.expect(r.total).to.eql(3); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/livres",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "livres"
          ]
        }
      }
    },
